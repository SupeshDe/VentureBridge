PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/venturebridge
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@venturebridge.local
ADMIN_PASSWORD=change-this-password

# Optional enterprise
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Required for registration email verification. For Gmail, enable 2-Step
# Verification and create an App Password; use that password, not your
# regular Gmail password. Other SMTP providers are also supported.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
MAIL_FROM=VentureBridge <no-reply@venturebridge.local>

# AI assistant (Gemini) — get a key at https://aistudio.google.com/apikey
# If unset, the assistant toggle shows a "not configured" notice.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Links inside emails must open on the reader's device (e.g. your phone).
# Set this to your machine's Wi-Fi IP so mails don't point at localhost.
# Find it with: ipconfig (look for IPv4 Address on Wi-Fi)
CLIENT_URL_PUBLIC=http://192.168.1.7:5173
